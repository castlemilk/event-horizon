<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Development entitlements for the AIC8800D80 dext, signed with an Apple
  Development identity against a DriverKit *development* provisioning profile.
  Loads with SIP left ON (systemextensionsctl developer on), per Apple's
  guidance that DriverKit development does not require disabling SIP.

  transport.usb value is an array of {idVendor[,idProduct]} dicts. Here it is
  pinned to the AIC8800D80 operational device — VID 0xa69c (42652), operational
  PIDs 0x8d81 (36225) / 0x8d83 (36235). A development profile authorizes these
  without the specific-VID Apple approval that DISTRIBUTION requires. If the
  generated profile turns out to grant a wildcard instead, read its exact form
  with `security cms -D -i <profile>` and mirror it here verbatim.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.driverkit</key>
	<true/>
	<key>com.apple.developer.driverkit.family.networking</key>
	<true/>
	<key>com.apple.developer.driverkit.transport.usb</key>
	<array>
		<dict>
			<key>idVendor</key>
			<integer>42652</integer>
			<key>idProduct</key>
			<integer>36225</integer>
		</dict>
		<dict>
			<key>idVendor</key>
			<integer>42652</integer>
			<key>idProduct</key>
			<integer>36235</integer>
		</dict>
	</array>
</dict>
</plist>
