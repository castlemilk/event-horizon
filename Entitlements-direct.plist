<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the DIRECT (non-App-Store) build.

  The difference that matters is the absence of com.apple.security.app-sandbox.
  A sandboxed build cannot drive the dongle, for two independent reasons:

    1. Raw libusb access is not available inside the App Sandbox, so the
       daemon could never claim the device even if it were running as root.
    2. Privilege escalation is blocked. The supervisor's authorization prompt
       fails with AppleScript error -60005 ("The administrator username or
       password was incorrect") — the sandbox refuses the escalation rather
       than the credentials being wrong, which is why the message is
       misleading.

  So the App Store flavour is a viewer: it can talk to a daemon someone else
  started, and nothing more. This flavour is the one that can bootstrap
  hardware. Sign it with Developer ID and notarise for distribution.

  com.apple.security.device.usb is retained even though it is a sandbox key —
  harmless outside the sandbox, and it keeps the two files comparable.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <key>com.apple.security.device.usb</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Hardened runtime needs these for the Go daemon and libusb. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
